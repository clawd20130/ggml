#version 450

#if defined(GGML_CONV_TRANSPOSE_1D_FLOAT16)
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

#include "types.glsl"

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};   // kernel: [K, Cout, Cin]
layout (binding = 1) readonly buffer B {B_TYPE data_b[];};   // input:  [L, Cin]
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};  // output: [T, Cout]

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout (push_constant) uniform parameter {
    uint32_t Cout;
    uint32_t Cin;
    uint32_t K;
    uint32_t L;
    uint32_t T;
    uint32_t nb01;
    uint32_t nb02;
    uint32_t nb11;
    uint32_t nb1;
    int32_t s0;
    int32_t p0;
    uint32_t g0;
} p;

int floor_div_pos_den(int n, int d) {
    if (n >= 0) {
        return n / d;
    }
    return -((-n + d - 1) / d);
}

int ceil_div_pos_den(int n, int d) {
    if (n >= 0) {
        return (n + d - 1) / d;
    }
    return -((-n) / d);
}

void main() {
    const uint32_t out_t = gl_GlobalInvocationID.x;
    const uint32_t out_channel = gl_WorkGroupID.y;

    if (out_t >= p.T) {
        return;
    }

    const uint32_t channels_per_group = p.Cin / p.g0;
    const bool dense_group = p.g0 == 1;
    const uint32_t out_group = dense_group ? 0 : out_channel / p.Cout;
    const uint32_t out_channel_in_group = dense_group ? out_channel : out_channel - out_group * p.Cout;
    const uint32_t input_start = dense_group ? out_channel / channels_per_group : out_group * channels_per_group;
    float sum = 0.0;

    if (dense_group && out_channel >= p.Cout) {
        return;
    }

    const int32_t stride = p.s0;
    if (stride <= 0) {
        return;
    }

    const int32_t low = int32_t(out_t) + p.p0 - int32_t(p.K) + 1;
    const int32_t high = int32_t(out_t) + p.p0;
    int32_t in_t_start = ceil_div_pos_den(low, stride);
    int32_t in_t_end = floor_div_pos_den(high, stride);
    in_t_start = max(in_t_start, 0);
    in_t_end = min(in_t_end, int32_t(p.L) - 1);

    for (int32_t in_t_i = in_t_start; in_t_i <= in_t_end; ++in_t_i) {
        const uint32_t in_t = uint32_t(in_t_i);
        const int32_t kernel_t = int32_t(out_t) - int32_t(in_t) * p.s0 + p.p0;
        if (kernel_t < 0 || kernel_t >= int32_t(p.K)) {
            continue;
        }

        for (uint32_t ci = 0; ci < channels_per_group; ++ci) {
            uint32_t input_t = in_t;
            uint32_t input_channel = input_start + ci;
            if (dense_group) {
                const uint32_t input_linear = in_t * p.Cin + input_channel;
                if (input_linear >= p.L * p.Cin) {
                    continue;
                }
                input_t = input_linear / p.Cin;
                input_channel = input_linear - input_t * p.Cin;
            } else if (out_group >= p.g0 || input_channel >= p.Cin) {
                continue;
            }

            const uint32_t kernel_channel = dense_group ? ci : input_channel;
            const float k = float(data_a[uint32_t(kernel_t) + out_channel_in_group * p.nb01 + kernel_channel * p.nb02]);
            const float x = float(data_b[input_t + input_channel * p.nb11]);
            sum += k * x;
        }
    }

    data_d[out_t + out_channel * p.nb1] = D_TYPE(sum);
}
